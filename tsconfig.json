{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react-jsx",
        "jsxImportSource": "@opentui/react",
        "types": ["bun"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "bunli.config.ts", "*.config.ts"]
}
