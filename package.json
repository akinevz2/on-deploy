{
  "name": "on-deploy",
  "version": "1.1.0",
  "description": "Rigorous dotfiles requirement deployer — reads wm.requires, verifies each binary, installs the missing ones via the platform deploy script",
  "type": "module",
  "bin": {
    "on-deploy": "src/index.ts"
  },
  "scripts": {
    "dev": "bunli dev",
    "build": "bunli build",
    "check": "bun src/index.ts check"
  },
  "dependencies": {
    "@bunli/core": "^0.8.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bunli": "^0.8.2",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "trustedDependencies": [
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akinevz2/on-deploy.git"
  },
  "license": "GPL-2.0-or-later",
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "package.json",
    "bunli.config.ts",
    ".bunli/"
  ]
}
